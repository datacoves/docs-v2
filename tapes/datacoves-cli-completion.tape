Output "../docs/reference/vscode/assets/datacoves-cli-completion.gif"
Source "_settings.tape"
Set Height 400
Source "_enter-code-server.tape"

Type "datacoves m"
Sleep 500ms
Tab
Sleep 1200ms
Tab@300ms 2
Sleep 2500ms
Type "db"
Tab
Sleep 1s
Type "--"
Tab@300ms 2
Sleep 2500ms
Ctrl+C
Type "datacoves my api-key "
Tab@300ms 2
Sleep 2500ms
Ctrl+C
Type "datacoves --"
Tab@300ms 2
Sleep 3s
Ctrl+C
Sleep 500ms
